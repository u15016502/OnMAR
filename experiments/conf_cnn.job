python3 -m venv venv
source venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt



?????? timeout 120 python3 -u runner.py --quick-test 2>&1

conda deactivate


# 1. Navigate to root folder (if not already there)
cd "/Users/miagerber/Documents/Journal article experiments"

# 2. Activate virtual environment
source venv/bin/activate

# 3. Navigate to test directory
cd experiments/test

# CNN (5 commands)
python runner.py --application cnn --all-datasets --techniques onmar-design --timesteps 10 --runs 1
